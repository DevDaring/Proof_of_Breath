#!/usr/bin/env python3
"""Git pre-push hook: gate non-fast-forward pushes and deletions of protected branches."""
import os
import re
import subprocess
import sys
from pathlib import Path

real = Path(__file__).resolve()
for base in (real.parent.parent / "common", Path(os.environ.get("POB_HOME", Path.home() / ".pob")) / "common"):
    if (base / "pob_client.py").exists():
        sys.path.insert(0, str(base))
        break
import pob_client  # noqa: E402

PROTECTED = re.compile(r"^refs/heads/(main|master|prod|production|release|trunk|develop)$")
ZERO = re.compile(r"^0+$")


def is_forced(local_sha: str, remote_sha: str) -> bool:
    if ZERO.match(remote_sha):
        return False
    if ZERO.match(local_sha):
        return True
    if subprocess.run(["git", "cat-file", "-e", remote_sha], capture_output=True).returncode != 0:
        return True  # The remote tip is unknown here, so this cannot be shown to be a fast-forward.
    return subprocess.run(["git", "merge-base", "--is-ancestor", remote_sha, local_sha], capture_output=True).returncode != 0


def main() -> int:
    remote = sys.argv[1] if len(sys.argv) > 1 else "origin"
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4:
            continue
        _, local_sha, remote_ref, remote_sha = parts
        if not PROTECTED.match(remote_ref) or not is_forced(local_sha, remote_sha):
            continue
        branch = remote_ref.rsplit("/", 1)[-1]
        command = f"git push --force {remote} {branch}"
        allowed, message = pob_client.gate_command(command, "git", os.getcwd())
        if not allowed:
            print(f"Push blocked. {message}", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
