[
 {"key":"terraform-destroy","scope":"shell","severity":"critical","reason":"Destroys all infrastructure managed by this Terraform state","pattern":"\\b(?:terraform|tofu)(?:\\.exe)?\\b[^;&|\\n]*\\b(?:destroy\\b|apply\\b[^;&|\\n]*\\s-destroy\\b)"},
 {"key":"sql-drop","scope":"sql","severity":"critical","reason":"Permanently drops a table, database or schema","pattern":"\\bdrop\\s+(?:table|database|schema)\\b"},
 {"key":"sql-truncate","scope":"sql","severity":"high","reason":"Removes every row from a table","pattern":"\\btruncate\\s+(?:table\\s+)?(?!-)[\\w\\\"`\\[]"},
 {"key":"sql-delete-no-where","scope":"sql","severity":"high","reason":"DELETE with no WHERE clause removes every row","pattern":"\\bdelete\\s+from\\s+\\S+(?![^;]*\\bwhere\\b)"},
 {"key":"git-force-protected","scope":"git","severity":"critical","reason":"Force push overwrites the history of a protected branch","pattern":"\\bgit\\b[^;&|\\n]*\\bpush\\b(?=[^;&|\\n]*\\s(?:--force(?:-with-lease)?(?:=\\S+)?|-[a-z]*f[a-z]*)(?:\\s|$))[^;&|\\n]*\\s(?:\\S+:)?(?:refs/heads/)?(?:main|master|prod|production|release|trunk|develop)(?:\\s|$)"},
 {"key":"git-force-plus-refspec","scope":"git","severity":"critical","reason":"A plus refspec force pushes to a protected branch","pattern":"\\bgit\\b[^;&|\\n]*\\bpush\\b[^;&|\\n]*\\s\\+(?:\\S+:)?(?:refs/heads/)?(?:main|master|prod|production|release|trunk|develop)(?:\\s|$)"},
 {"key":"git-force-implicit","scope":"git","severity":"high","reason":"Force push with no explicit branch may hit a protected branch","pattern":"\\bgit\\b(?:\\s+-\\S+(?:\\s+[^\\s-]\\S*)?)*\\s+push(?=[^;&|\\n]*\\s(?:--force(?:-with-lease)?(?:=\\S+)?|-[a-z]*f[a-z]*)(?:\\s|$))(?:\\s+-\\S+)*(?:\\s+[^\\s;&|-]\\S*)?(?:\\s+-\\S+)*\\s*(?:$|[;&|\\n])"},
 {"key":"git-reset-hard","scope":"git","severity":"high","reason":"Hard reset discards local commits and changes","pattern":"\\bgit\\b[^;&|\\n]*\\breset\\b[^;&|\\n]*\\s--hard\\b"},
 {"key":"rm-recursive-force","scope":"shell","severity":"critical","reason":"Recursive forced delete outside the temporary allow-list","pattern":"\\brm\\b(?=[^;&|\\n]*\\s-(?:[a-z]*r[a-z]*|-recursive)(?:\\s|$))(?=[^;&|\\n]*\\s-(?:[a-z]*f[a-z]*|-force)(?:\\s|$))[^;&|\\n]*\\s(?!-)(?!(?:/tmp|/var/tmp|\\$tmpdir|\\$env:temp|c:\\\\temp|c:\\\\windows\\\\temp)(?:[/\\\\](?:(?!\\.\\.)[^\\s/\\\\;&|])+)*[/\\\\]?(?:\\s|$|[;&|]))\\S+"},
 {"key":"powershell-remove-item","scope":"shell","severity":"critical","reason":"PowerShell recursive forced delete outside the temporary allow-list","pattern":"\\b(?:remove-item|ri|rm|del|erase|rd|rmdir)\\b(?=[^;&|\\n]*\\s-r(?:ecurse|ecurs|ecur|ecu|ec|e)?(?:\\s|$))(?=[^;&|\\n]*\\s-fo(?:rce|rc|r)?(?:\\s|$))[^;&|\\n]*\\s(?!-)(?!(?:\\$env:temp|c:\\\\temp|c:\\\\windows\\\\temp)(?:[/\\\\](?:(?!\\.\\.)[^\\s/\\\\;&|])+)*[/\\\\]?(?:\\s|$|[;&|]))\\S+"},
 {"key":"cmd-recursive-delete","scope":"shell","severity":"critical","reason":"Windows recursive delete","pattern":"\\b(?:rd|rmdir|del|erase)\\b[^;&|\\n]*\\s/s\\b"},
 {"key":"kubectl-delete-namespace","scope":"shell","severity":"critical","reason":"Deletes a whole Kubernetes namespace and everything in it","pattern":"\\bkubectl\\b[^;&|\\n]*\\bdelete\\b[^;&|\\n]*\\s(?:ns|namespaces?)(?:/\\S+)?(?:\\s|$)"},
 {"key":"docker-prune-volumes","scope":"shell","severity":"high","reason":"Removes all unused images and volumes","pattern":"\\bdocker\\b[^;&|\\n]*\\bsystem\\s+prune\\b(?=[^;&|\\n]*\\s(?:-[a-z]*a[a-z]*|--all)(?:\\s|$))(?=[^;&|\\n]*\\s--volumes(?:\\s|$))"},
 {"key":"aws-delete","scope":"shell","severity":"high","reason":"AWS CLI delete call","pattern":"\\baws\\b[^;&|\\n]*\\s(?:delete-[a-z0-9-]+|s3\\s+rb\\b|s3\\s+rm\\b[^;&|\\n]*--recursive)"},
 {"key":"azure-delete","scope":"shell","severity":"high","reason":"Azure CLI delete call","pattern":"\\baz\\b[^;&|\\n]*\\sdelete(?:\\s|$)"},
 {"key":"gcloud-delete","scope":"shell","severity":"high","reason":"Google Cloud CLI delete call","pattern":"\\bgcloud\\b[^;&|\\n]*\\sdelete(?:\\s|$)"}
]
